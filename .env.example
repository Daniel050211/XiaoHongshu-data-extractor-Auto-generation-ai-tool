# Apify（必填）
APIFY_API_KEY=
APIFY_COOKIE_STRING=

# AI 分析（選填，未填則以乾跑模式產出報告，不呼叫 AI）
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=z-ai/glm-5.2

# Foshan News AI (n8n "Schedule Trigger" line)
SERPER_API_KEY=                  # required: news search (https://serper.dev)
NEWS_AI_MODEL=z-ai/glm-5.2       # optional: overrides AI_MODEL for the news line
NEWS_SEARCH_QUERY=               # optional: overrides config.yaml news.search.query

# Email 回覆監看（選填）：優先使用本機 Outlook；要跨裝置收信才需 IMAP
EMAIL_IMAP_HOST=                 # 例如 imap.gmail.com / outlook.office365.com
EMAIL_IMAP_USER=                 # 信箱帳號
EMAIL_IMAP_PASSWORD=             # 應用程式密碼（Gmail 需開啟兩步驗證後產生）

# 電郵（選填，未填則不寄信）
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
EMAIL_CC=

# 寄信 API（443 埠，不會被網路封鎖）：SendGrid / Brevo / Resend 填其中一個
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
EMAIL_PROVIDER=           # outlook | sendgrid | brevo | resend | smtp（留空自動偵測）
EMAIL_FROM=

# 手機也能開審批表單（選填，也可在 App「設定」頁填）
# FORM_PUBLIC_URL 例如 https://your-domain.ngrok-free.dev（用 ngrok/Cloudflare 隧道取得）
FORM_PUBLIC_URL=
# FORM_TOKEN Authtoken（登入金鑰，必填）：表單網址必須帶 ?token=... 才能開啟/送出
FORM_TOKEN=

# 私人 Google Sheets 用的 service account JSON 路徑（選填）
GOOGLE_SERVICE_ACCOUNT_JSON=
